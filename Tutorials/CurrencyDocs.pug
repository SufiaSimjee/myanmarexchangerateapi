doctype html
html(lang="en")
    head
        meta(charset="UTF-8")
        title Currency Exchange API Documentation
        style.
            body { font-family: Arial, sans-serif; padding: 20px; line-height: 1.6; }
            h1, h2, h3 { color: #2c3e50; }
            pre { background: #ecf0f1; padding: 10px; border-radius: 5px; }
            code { background: #ecf0f1; padding: 2px 4px; border-radius: 3px; }

    body


        h1 Myanmar Currency Exchange API Documentation
        p Base URL:
            strong #{baseUrl}/

        h2 Authentication
        p Some endpoints (Update & Delete) require JWT authentication in header (Bearer).

        h2 Endpoints

        // --- Uploader List ---
        h3 GET /uploaderList
        p Retrieves a paginated list of all unique uploaders.
        p Query Parameters:
        ul
            li skip (optional, default: 0)
            li limit (optional, default: 10)
        p Example URL:
        pre
            code #{baseUrl}/uploaderList?skip=0&limit=10

        // --- Source List ---
        h3 GET /sourceList
        p Retrieves unique sources filtered by uploader.
        p Query Parameters:
        ul
            li uploader (optional, default: admin123)
            li skip, limit (pagination)
        p Example URL:
        pre
            code #{baseUrl}/sourceList?uploader=admin123&skip=0&limit=10

        // --- Currency List ---
        h3 GET /currencyList
        p Retrieves unique currencies filtered by uploader and source.
        p Query Parameters:
        ul
            li uploader (optional, default: admin123)
            li source (optional, default: MM Exchange)
            li skip, limit (pagination)
        p Example URL:
        pre
            code #{baseUrl}/currencyList?uploader=admin123&source=MM%20Exchange&skip=0&limit=10

        // --- Currency Uploader & Source ---
        h3 GET /findUploader&Source/:currencyCode
        p Returns all uploader-source pairs for a given currency code.
        p URL Parameters:
        ul
            li currencyCode (e.g., USD)
        p Query Parameters:
            ul
                li skip, limit (pagination)
        p Example URL:
        pre
            code #{baseUrl}/findUploader&Source/USD?skip=0&limit=10

        // --- Add Currency Rate ---
        h3 POST /add
        p Adds a new currency exchange rate. JWT authentication required.
        p Body Parameters (JSON):
        ul
            li currencyCode
            li unit
            li buyRate
            li sellRate
            li uploadedDate (YYYY-MM-DD HH:mm:ss)
            li source
        p Example URL:
        pre
            code #{baseUrl}/add

        // --- Delete Currency Rate ---
        h3 DELETE /delete/:id
        p Deletes a currency exchange rate. JWT authentication required.
        p URL Parameters:
        ul
            li id - Currency rate document ID
        p Example URL:
        pre
            code #{baseUrl}/delete/64ebf0b9c3a1f24e3e6d7d1a

        // --- Get Currency Rate by ID ---
        h3 GET /:id
        p Retrieves a currency exchange rate by ID with percentage change.
        p URL Parameters:
            ul
                li id - Currency rate document ID
        p Example URL:
        pre
            code #{baseUrl}/68aee86772631163e8e19134

        // --- Latest Currency Rate ---
        h3 GET /:currencyCode/latest
        p Retrieves the latest currency rate for a currency code. Use "ALL" to get all latest rates.
        p Query Parameters:
        ul
            li source, uploader (optional, default: MM Exchange, admin123)
        p Example URL:
        pre
            code #{baseUrl}/USD/latest?uploader=admin123&source=MM%20Exchange

        // --- Currency Rate by Date ---
        h3 GET /:currencyCode/:date
        p Retrieves currency rate for a specific date. Use "ALL" for all currencies.
        p Query Parameters:
        ul
            li skip, limit
            li source, uploader (optional, default: MM Exchange, admin123)
        p URL Parameters:
            ul
                li currencyCode
                li date (YYYY-MM-DD)
        p Example URL:
        pre
            code #{baseUrl}/USD/2025-08-27?uploader=admin123&source=Exchange%20Myanmar&skip=0&limit=10

        // --- Currency Rate by Date Range ---
        h3 GET /:currencyCode/:fromDate/:toDate
        p Retrieves currency rates between two dates.
        p Query Parameters:
        ul
            li skip, limit
            li source, uploader (optional, default: MM Exchange, admin123)
        p URL Parameters:
            ul
                li currencyCode
                li fromDate (YYYY-MM-DD)
                li toDate (YYYY-MM-DD)
        p Example URL:
        pre
            code #{baseUrl}/USD/2025-08-01/2025-08-27?uploader=admin123&source=MM%20Exchange&skip=0&limit=10
